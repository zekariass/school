{
  "name": "school-backend",
  "version": "0.0.1",
  "private": true,
  "description": "Spring Boot backend (Maven). This package.json lets Turborepo orchestrate it alongside the JS apps.",
  "scripts": {
    "dev": "./mvnw spring-boot:run -Dspring-boot.run.profiles=local",
    "build": "./mvnw -B -DskipTests package",
    "test": "./mvnw -B test",
    "openapi:export": "./mvnw -B -q test -Dtest=OpenApiSpecTest -Dsurefire.failIfNoSpecifiedTests=false -Dopenapi.write=true"
  }
}
