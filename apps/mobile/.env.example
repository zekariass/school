# Copy to `.env.local` (git-ignored) to override. Only EXPO_PUBLIC_* variables
# are inlined into the app bundle, so never put secrets here.

# Base URL of the School API (no trailing slash).
#
# Leave unset in development: the app derives it from the Metro host
# (http://<your-computer's-LAN-IP>:8180) so simulators and physical devices on
# the same Wi-Fi reach the local backend. Falls back to http://localhost:8180.
# Set it for tunnels, staging and production builds (EAS profiles set it too).
# EXPO_PUBLIC_API_URL=https://api.example.com
