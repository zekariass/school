# Origin of the School API. Server-only: the browser never sees it, it talks to
# the BFF at /api/bff/*. Defaults to http://localhost:8180 outside production;
# required in production.
API_ORIGIN=http://localhost:8180

# Public origin of this web app, e.g. https://app.example.com. Optional: mutating
# requests to /api/auth/* and /api/bff/* must come from this origin, and it
# defaults to the origin of the request URL. Set it behind a proxy that
# rewrites the host.
# APP_ORIGIN=https://app.example.com

# How browsers send uploaded files (NEXT_PUBLIC_*, fixed at build time):
#   direct (default)  PUT straight to the object store with a presigned URL; the bucket needs a CORS
#                     rule for this site's origin (local development sets it up).
#   proxy             stream the file through this server (PUT /api/bff/uploads/{mediaId}); use it
#                     when the bucket cannot allow this origin. Then list the store's origin below.
# NEXT_PUBLIC_UPLOAD_MODE=direct
# Storage origins the upload proxy may stream to (comma-separated, server-only). Defaults to
# http://localhost:8343 outside production; required in production when the mode is proxy.
# UPLOAD_PROXY_ORIGINS=https://<account>.r2.cloudflarestorage.com
