{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Multi-tenant school, family, learning and tutoring platform API. Errors are RFC 9457 problem details (application/problem+json) with a stable `code`.",
    "title" : "School API",
    "version" : "v1"
  },
  "servers" : [ {
    "description" : "Same origin",
    "url" : "/"
  } ],
  "paths" : {
    "/api/v1/meta" : {
      "get" : {
        "operationId" : "getMeta",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MetaResponse"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Error (RFC 9457 problem details)"
          }
        },
        "summary" : "Service metadata and server time",
        "tags" : [ "system" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "MetaResponse" : {
        "type" : "object",
        "properties" : {
          "apiVersion" : {
            "type" : "string"
          },
          "buildVersion" : {
            "type" : "string"
          },
          "serverTime" : {
            "type" : "string",
            "format" : "date-time"
          },
          "service" : {
            "type" : "string"
          },
          "supportedLocales" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        },
        "required" : [ "apiVersion", "buildVersion", "serverTime", "service", "supportedLocales" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "description" : "RFC 9457 problem details returned by every failing endpoint.",
        "properties" : {
          "code" : {
            "type" : "string",
            "description" : "Stable machine-readable error code"
          },
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "type" : "array",
            "description" : "Field errors (validation_failed)",
            "items" : {
              "type" : "object",
              "properties" : {
                "code" : {
                  "type" : "string"
                },
                "field" : {
                  "type" : "string"
                },
                "message" : {
                  "type" : "string"
                }
              },
              "required" : [ "code", "field", "message" ]
            }
          },
          "instance" : {
            "type" : "string"
          },
          "requestId" : {
            "type" : "string",
            "description" : "Correlates with server logs"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        },
        "required" : [ "code", "status", "title", "type" ]
      }
    }
  }
}
