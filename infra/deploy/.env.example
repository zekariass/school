# Environment of the single-host deployment (infra/deploy). Copy to `.env` ON THE SERVER, chmod 600, and fill in.
# NEVER commit the real file. Every value below is a placeholder.
#
# Legend:  [SECRET]  never in git, never in logs, rotate per docs/ops/Runbook.md
#          [required] the stack refuses to start without it
#          (default) used when the line is left out
#
# The backend additionally refuses to start (and prints every problem at once) when a value is missing or unsafe:
# development credentials, localhost endpoints, http:// origins, console SMS in production, and so on.
# Image references are NOT set here: ./deploy.sh writes them to .deploy/images.env.

# ---------------------------------------------------------------- environment
# staging | prod. Selects the Spring profile (strict startup validation, JSON logs, validate-only Flyway).
SCHOOL_PROFILE=staging
# Which services run on this host. Single-VM: database and Redis in containers, access through a Cloudflare tunnel.
# Managed Postgres/Redis: drop local-db / local-redis. Direct origin with an Origin CA certificate: drop tunnel.
COMPOSE_PROFILES=local-db,local-redis,tunnel

# ---------------------------------------------------------------- hostnames (no scheme)
# [required] Public hostnames served through Cloudflare, e.g. staging.example.org and api.staging.example.org.
APP_HOST=staging.example.org
API_HOST=api.staging.example.org
# [required] Public origin of the web app (https, no trailing slash). Mutating BFF requests must come from it.
APP_ORIGIN=https://staging.example.org
# [required] Browser origins allowed to call the API (comma-separated, https only, no wildcard). The web app's origin.
CORS_ALLOWED_ORIGINS=https://staging.example.org
# [required] Origin used in guardian invitation links (the web app).
SCHOOL_GUARDIANS_INVITE_BASE_URL=https://staging.example.org

# ---------------------------------------------------------------- Cloudflare tunnel
# [SECRET] [required with the "tunnel" profile] Token of a remotely-managed tunnel (Zero Trust > Networks > Tunnels).
# Route app host -> http://proxy:80 and API host -> http://proxy:80 in the tunnel's public hostnames.
TUNNEL_TOKEN=

# ---------------------------------------------------------------- database
# [required] JDBC URL. Local container: jdbc:postgresql://postgres:5432/school. Managed: add ?sslmode=require
DB_URL=jdbc:postgresql://postgres:5432/school
DB_USERNAME=school_app
# [SECRET] [required] at least 12 characters; "school", "postgres", etc. are refused at startup.
DB_PASSWORD=
POSTGRES_DB=school

# ---------------------------------------------------------------- Redis
# [SECRET] [required with the local-redis profile] password of the Redis container.
REDIS_PASSWORD=
# [required] Local container: redis://:<REDIS_PASSWORD>@redis:6379 . Managed: rediss://default:<password>@host:6379
REDIS_URL=redis://:CHANGE_ME@redis:6379

# ---------------------------------------------------------------- tokens and codes
# [SECRET] [required] JWK Set of EC P-256 keys with private parts, in SINGLE quotes. First key signs. Generate:
#   npm run -s jwk:generate -w school-backend      (put a new key FIRST to rotate; drop the old one after 15 minutes)
SCHOOL_AUTH_JWT_KEYS='{"keys":[]}'
# [SECRET] [required] HMAC key of stored one-time codes and student login codes, at least 32 random characters:
#   openssl rand -base64 48 | tr -d '\n'     (changing it invalidates every issued student login code)
SCHOOL_AUTH_OTP_PEPPER=
# [SECRET] [required] AES-256 keys that encrypt safeguarding incidents (narrative, notes, referral): base64 of 32 random bytes,
#   openssl rand -base64 32 | tr -d '\n'
# The ACTIVE key id names the key new text is encrypted with; every listed key still decrypts (rotation: add K2, set the active id
# to k2, keep K1 as long as incidents written under it exist). Key ids are lower case. Back the keys up SEPARATELY from the database
# (docs/ops/Runbook.md section 6). The backend refuses to start without a valid key and refuses the development keys.
SCHOOL_SAFEGUARDING_ENCRYPTION_ACTIVE_KEY_ID=k1
SCHOOL_SAFEGUARDING_ENCRYPTION_KEYS_K1=
# optional rotation slots (leave unset until rotating):
# SCHOOL_SAFEGUARDING_ENCRYPTION_KEYS_K2=
# SCHOOL_SAFEGUARDING_ENCRYPTION_KEYS_K3=
# (school-api / school-apps)
SCHOOL_AUTH_JWT_ISSUER=school-api
SCHOOL_AUTH_JWT_AUDIENCE=school-apps

# ---------------------------------------------------------------- SMS and push
# [required] Only "console" exists today (codes go to the LOG). Staging may use it with SCHOOL_SMS_ALLOW_CONSOLE=true;
# production refuses it: a real provider must be integrated first (docs/ops/Hosting_Options.md, SMS).
SCHOOL_SMS_PROVIDER=console
SCHOOL_SMS_ALLOW_CONSOLE=true
# [required] expo (real pushes) or log (staging only, with SCHOOL_PUSH_ALLOW_LOG=true)
SCHOOL_PUSH_PROVIDER=expo
SCHOOL_PUSH_ALLOW_LOG=false
# [SECRET] optional, Expo "enhanced push security" access token
EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------- email (optional)
# Without SPRING_MAIL_HOST, email sign-in codes are dropped with a warning. Leave these lines commented until used.
# SPRING_MAIL_HOST=smtp.example.org
SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# [SECRET]
# SPRING_MAIL_PASSWORD=
SCHOOL_MAIL_FROM=School <no-reply@staging.example.org>

# ---------------------------------------------------------------- first administrator
# Created at startup only while no active platform administrator exists. Set your real phone (E.164), never the dev one.
SCHOOL_BOOTSTRAP_ADMIN_PHONE=
SCHOOL_BOOTSTRAP_ADMIN_EMAIL=
SCHOOL_BOOTSTRAP_ADMIN_NAME=Platform administrator

# ---------------------------------------------------------------- object storage (Cloudflare R2)
# [required] https://<ACCOUNT_ID>[.eu].r2.cloudflarestorage.com  (docs/research/R2_Compatibility.md)
SCHOOL_STORAGE_ENDPOINT=
# Host that browsers and phones put in presigned URLs. For R2 the same value as the endpoint (default).
SCHOOL_STORAGE_PUBLIC_ENDPOINT=
# auto for R2
SCHOOL_STORAGE_REGION=auto
# [required] one bucket per environment
SCHOOL_STORAGE_BUCKET=
# [SECRET] [required] runtime token: Object Read & Write scoped to that ONE bucket (not an Admin token)
SCHOOL_STORAGE_ACCESS_KEY=
SCHOOL_STORAGE_SECRET_KEY=
# Web proxy-upload fallback only (NEXT_PUBLIC_UPLOAD_MODE=proxy): comma-separated storage origins
# UPLOAD_PROXY_ORIGINS=

# ---------------------------------------------------------------- observability (all optional, off when empty)
# [SECRET] Sentry (or compatible) DSN: enables error tracking in the backend. Scrubbed of request bodies and PII.
# SENTRY_DSN=
# OTLP/HTTP trace endpoint of a collector, e.g. http://collector:4318/v1/traces. LEAVE THE LINE OUT (or commented)
# to disable export: an empty value breaks startup. Same rule for SPRING_MAIL_*, SENTRY_DSN and UPLOAD_PROXY_ORIGINS:
# set them only when used; they are passed to the containers only when present.
# MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://collector:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=0.1
OTLP_METRICS_EXPORT_ENABLED=false

# ---------------------------------------------------------------- sizing (defaults suit a 2 vCPU / 4 GB host for staging)
BACKEND_CPUS=2.0
BACKEND_MEMORY=1536m
BACKEND_JAVA_OPTIONS=-XX:MaxRAMPercentage=70
WEB_CPUS=1.0
WEB_MEMORY=512m
POSTGRES_CPUS=2.0
POSTGRES_MEMORY=2g
REDIS_MAXMEMORY=256mb

# ---------------------------------------------------------------- proxy exposure
# Published on loopback only by default: reach it through the tunnel. For a direct origin set the bind
# addresses to 0.0.0.0, the ports to 80/443 and CADDYFILE=Caddyfile.origin-tls.
PROXY_BIND=127.0.0.1
PROXY_HTTP_PORT=8080
PROXY_BIND_TLS=127.0.0.1
PROXY_HTTPS_PORT=8443
CADDYFILE=Caddyfile

# ---------------------------------------------------------------- deploy.sh
# Registry credentials, only when the GHCR packages are private. [SECRET]
GHCR_USER=
GHCR_TOKEN=
# Optional public smoke test after a roll-out (https, no trailing slash), e.g. https://api.staging.example.org
PUBLIC_API_URL=
PUBLIC_WEB_URL=
